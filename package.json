{
  "name": "tv-paper-api",
  "version": "0.3.0",
  "description": "TradingView paper trading over a local API and web console, with portable sealed credentials.",
  "type": "module",
  "module": "src/server.ts",
  "bin": {
    "tv-paper": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run src/server.ts",
    "cli": "bun run src/cli.ts",
    "credctl": "bun run src/credctl.ts",
    "build:web": "cd web && bun install --frozen-lockfile && bun run build",
    "dev:web": "cd web && bun run dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "cd web && tsc -b --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "private": true
}
